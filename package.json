{
  "name": "yacs",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts playwright.config.ts app.json tsconfig.json package.json",
    "check:native": "expo export --platform all --output-dir native-check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "assets": "node scripts/icons.mjs",
    "build:web": "npm run assets && expo export --platform web && node scripts/pwa.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "overrides": {
    "expo-router": "$expo-router"
  },
  "private": true
}
