{
  "expo": {
    "name": "YACS",
    "slug": "yacs",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/yacs-icon.png",
    "scheme": "yacs",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#193D34",
        "foregroundImage": "./assets/images/yacs-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a meal photo for YACS.",
          "cameraPermission": "Take a meal photo with YACS.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
